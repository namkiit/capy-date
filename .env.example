# Postgres — local dev: docker compose up -d; production: Neon connection string
DATABASE_URL=postgresql://capy:capy@localhost:5434/capydate

# Admin panel
ADMIN_PASSWORD=
# Secret ký cookie session admin — chuỗi random dài (vd: openssl rand -hex 32)
ADMIN_SESSION_SECRET=

# Resend — thông báo email khi có submission
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Capy Date <onboarding@resend.dev>
NOTIFY_EMAIL_TO=

# Vercel Blob — upload ảnh trong admin (chỉ cần khi deploy hoặc test upload)
BLOB_READ_WRITE_TOKEN=

# Base URL của site (metadata / OG image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
